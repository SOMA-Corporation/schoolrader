# 이 파일은 없어도 된다. 인증키는 api/schoolinfo.js 에 상수로 들어 있다.
# 아래는 전부 '덮어쓰고 싶을 때만' 쓰는 선택값이다.

# 다른 인증키로 갈아끼울 때
# SCHOOLINFO_API_KEY=

# claude 실행 경로·인자 (기본값이 api/report.js 에 박혀 있다)
# SR_CLAUDE_BIN=claude
# SR_CLAUDE_ARGS=-p --output-format stream-json --verbose --permission-mode acceptEdits --allowedTools Read,Write,Edit,Glob,Grep,Bash
